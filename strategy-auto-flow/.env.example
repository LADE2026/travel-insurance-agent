# =====================================================================
#  PLANTILLA DE CLAVES DE STRATEGY AUTO FLOW
#  1. Copia este archivo y nómbralo exactamente:  .env
#  2. Llena los valores. El archivo .env NUNCA se sube a GitHub.
#  3. En Render, estas mismas variables se ponen en "Environment".
# =====================================================================

# --- Fase 1A: necesarias ya -------------------------------------------
# Clave secreta de Django. Genera una larga y al azar (Render la crea sola).
SECRET_KEY=cambia-esto-por-una-clave-larga-y-al-azar
# True solo en tu computadora. En internet SIEMPRE False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# En tu computadora se usa SQLite si dejas esto vacío. Render lo llena solo.
# DATABASE_URL=postgres://usuario:clave@servidor:5432/base
# Tu cuenta de administrador (se crea sola la primera vez en Render)
ADMIN_EMAIL=
ADMIN_PASSWORD=
EMPRESA_EMAIL=info@strategyautoflow.com
EMPRESA_TELEFONO=
# Pon False cuando un abogado revise privacidad y términos.
LEGAL_BORRADOR=True

# --- Fase 1B: fotos (Cloudflare R2) -----------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# --- Fase 1C: descripciones con IA (Anthropic) -------------------------
# ANTHROPIC_API_KEY=

# --- Fase 1D: Facebook e Instagram (Meta) ------------------------------
# META_APP_ID=
# META_APP_SECRET=
